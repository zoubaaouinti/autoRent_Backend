{
  "info": {
    "name": "AutoRent API",
    "description": "Collection de test pour tous les endpoints de l'API AutoRent - Scripts pour automatiser les tokens",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body && body.token) {",
                  "        pm.environment.set('token', body.token);",
                  "        pm.environment.set('refreshToken', body.refreshToken);",
                  "        console.log('✓ Token stocké: ' + body.token.substring(0, 20) + '...');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"displayName\": \"John Doe\",\n  \"phoneNumber\": \"+33612345678\",\n  \"address\": \"123 Rue de Paris, Paris\",\n  \"bio\": \"Je suis un utilisateur de test\",\n  \"dateOfBirth\": \"1990-01-15\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body && body.token) {",
                  "        pm.environment.set('token', body.token);",
                  "        pm.environment.set('refreshToken', body.refreshToken);",
                  "        pm.environment.set('userId', body.user.id);",
                  "        console.log('✓ Login réussi! Token stocké automatiquement.');",
                  "        console.log('✓ Utilisateur: ' + body.user.email);",
                  "    }",
                  "} else {",
                  "    console.log('✗ Erreur de login: ' + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✓ Email vérifié avec succès!');",
                  "} else {",
                  "    console.log('✗ Erreur lors de la vérification: ' + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/verify-email?email=user@example.com&otp=1234",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "verify-email"],
              "query": [
                {
                  "key": "email",
                  "value": "user@example.com",
                  "description": "Email de l'utilisateur"
                },
                {
                  "key": "otp",
                  "value": "1234",
                  "description": "OTP à 4 chiffres reçu par email"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✓ Email de réinitialisation envoyé');",
                  "} else {",
                  "    console.log('✗ Erreur: ' + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/forgot-password?email=user@example.com",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "forgot-password"],
              "query": [
                {
                  "key": "email",
                  "value": "user@example.com"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✓ Mot de passe réinitialisé avec succès!');",
                  "} else {",
                  "    console.log('✗ Erreur: ' + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/reset-password?email=user@example.com&otp=1234&newPassword=NewPassword123!",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "auth", "reset-password"],
              "query": [
                {
                  "key": "email",
                  "value": "user@example.com"
                },
                {
                  "key": "otp",
                  "value": "1234",
                  "description": "OTP à 4 chiffres reçu par email"
                },
                {
                  "key": "newPassword",
                  "value": "NewPassword123!"
                }
              ]
            }
          },
          "response": []
        }
        ,
        {
          "name": "Change Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✓ Mot de passe changé avec succès');",
                  "} else {",
                  "    console.log('✗ Erreur: ' + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"OldPassword123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/change-password",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "auth",
                "change-password"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    console.log('✓ Profil mis à jour');",
                  "} else {",
                  "    console.log('✗ Erreur: ' + pm.response.code);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Nouveau Nom\",\n  \"phoneNumber\": \"0612345678\",\n  \"address\": \"123 Rue Exemple\",\n  \"dateOfBirth\": \"1990-01-01\",\n  \"bio\": \"Ma nouvelle bio\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/auth/profile",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "auth",
                "profile"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Protected Routes Example",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT token stocké automatiquement après login"
              }
            ],
            "url": {
